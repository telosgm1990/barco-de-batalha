#!/bin/sh
# Roda o caçador de segredos antes de cada commit e barra o commit se ele
# achar algo. Pra ativar neste clone (uma vez só):
#
#   git config core.hooksPath scripts/git-hooks

root="$(git rev-parse --show-toplevel)"

# Com o .venv criado, usa o alias instalado pelo pyproject.toml.
for alias in "$root/scripts/.venv/Scripts/check-secrets.exe" \
             "$root/scripts/.venv/bin/check-secrets"; do
    if [ -x "$alias" ]; then
        exec "$alias"
    fi
done

# Sem .venv: o caçador só usa biblioteca padrão, qualquer Python serve.
cd "$root/scripts" || exit 1
for python in python3 python; do
    if "$python" --version >/dev/null 2>&1; then
        exec "$python" -m check_secrets
    fi
done

echo "pre-commit: Python não encontrado — o caçador de segredos não rodou." >&2
exit 1
