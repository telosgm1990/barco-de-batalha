#!/bin/sh
# Roda o caçador de segredos antes de cada commit e barra o commit se ele
# achar algo. Pra ativar neste clone (uma vez só):
#
#   git config core.hooksPath scripts/git-hooks

root="$(git rev-parse --show-toplevel)"

for python in python3 python; do
    if "$python" --version >/dev/null 2>&1; then
        exec "$python" "$root/scripts/check_secrets.py"
    fi
done

echo "pre-commit: Python não encontrado — o caçador de segredos não rodou." >&2
exit 1
