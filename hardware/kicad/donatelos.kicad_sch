(text "- GPIO2, 8 e 9 sao strapping (p. 30): livres. GPIO8 = LED, GPIO9 = BOOT." (exclude_from_sim no) (at 20.32 176.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2b2baeaf-6f97-510d-bb19-7369eb788034"))
